        console.log('Raw embedding dimensions:', embedding.length);
        
        let finalEmbedding;
        if (embedding.length === 512) {
          finalEmbedding = embedding;
        } else {
          // If the model outputs different dimensions, we might need to pad or truncate
          console.log('Adjusting embedding to 512 dimensions...');
          finalEmbedding = adjustEmbeddingDimensions(embedding);
        }
        
        currentEmbedding = finalEmbedding;
        displayResults(finalEmbedding);
        
      } catch (error) {
        console.error('Processing failed:', error);
        alert('Failed to process image: ' + error.message);
      } finally {
        processBtn.disabled = false;
        processBtn.textContent = 'Generate Embedding';
      }
    }
    
    // Adjust embedding dimensions if needed
    function adjustEmbeddingDimensions(embedding) {
      if (embedding.length === 512) {
        return embedding;
      } else if (embedding.length > 512) {
        // Truncate to 512
        return embedding.slice(0, 512);
      } else {
        // Pad with zeros to reach 512
        const padded = new Array(512).fill(0);
        for (let i = 0; i < embedding.length; i++) {
          padded[i] = embedding[i];
        }
        return padded;
      }
    }
    
    // Image upload handling
    const uploadArea = document.getElementById('uploadArea');
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    
    uploadArea.addEventListener('click', () => imageInput.click());
    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('dragover');
    });
    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('dragover');
    });
    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('dragover');
      const files = e.dataTransfer.files;
      if (files.length > 0) handleImageUpload(files[0]);
    });
    
    imageInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) handleImageUpload(e.target.files[0]);
    });
    
    // Track selected piece for API testing
    const selectElement = document.getElementById('clothingPieceSelect');
    if (selectElement) {
      selectElement.addEventListener('change', (e) => {
        selectedPieceId = e.target.value;
        console.log('Selected piece ID:', selectedPieceId);
      });
    }
    
    function handleImageUpload(file) {
      if (!file.type.startsWith('image/')) {
        alert('Please select an image file');
        return;
      }
      
      const reader = new FileReader();
      reader.onload = (e) => {
        previewImg.src = e.target.result;
        previewImg.onload = () => {
          imagePreview.style.display = 'block';
          document.getElementById('resultsSection').style.display = 'none';
        };
      };
      reader.readAsDataURL(file);
    }
    
    function displayResults(embedding) {
      // Show embedding vector
      document.getElementById('embeddingVector').textContent = embedding.map(v => v.toFixed(6)).join(', ');
      
      // Calculate vector magnitude
      const magnitude = Math.sqrt(embedding.reduce((sum, val) => sum + val * val, 0));
      document.getElementById('vectorMagnitude').textContent = magnitude.toFixed(4);
      
      // Show top dimensions
      const indexed = embedding.map((val, idx) => ({ value: val, index: idx }));
      indexed.sort((a, b) => Math.abs(b.value) - Math.abs(a.value));
      const topDims = indexed.slice(0, 5).map(item => 
        `[${item.index}]: ${item.value.toFixed(4)}`
      ).join('\\n');
      document.getElementById('topDimensions').textContent = topDims;
      
      // Enable integration controls
      document.getElementById('sendBtn').disabled = false;
      document.getElementById('apiEmbeddingBtn').disabled = false;
      document.getElementById('apiSimilarBtn').disabled = false;
      document.getElementById('apiSearchBtn').disabled = false;
      document.getElementById('resultsSection').style.display = 'block';
    }
    
    function copyEmbedding() {
      if (!currentEmbedding) return;
      
      navigator.clipboard.writeText(currentEmbedding.map(v => v.toFixed(6)).join(', ')).then(() => {
        const btn = document.getElementById('copyBtn');
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = originalText, 2000);
      });
    }
    
    function clearImage() {
      imagePreview.style.display = 'none';
      document.getElementById('resultsSection').style.display = 'none';
      imageInput.value = '';
      currentEmbedding = null;
      selectedPieceId = null;
    }
    
    // Web form submission (original method)
    async function sendToRails() {
      const pieceId = document.getElementById('clothingPieceSelect').value;
      if (!pieceId || !currentEmbedding) return;
      
      const resultDiv = document.getElementById('railsResult');
      resultDiv.innerHTML = '<div class="status loading">Sending to Rails...</div>';
      
      try {
        const formData = new FormData();
        formData.append('vector_data', currentEmbedding.map(v => v.toFixed(6)).join(','));
        formData.append('model_version', 'clip-vit-base-patch32');
        formData.append('confidence_score', '0.90');
        
        const response = await fetch(`/closet/${pieceId}/upload_embedding`, {
          method: 'POST',
          body: formData,
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
          }
        });
        
        if (response.ok) {
          resultDiv.innerHTML = '<div class="status success"> Web form upload successful!</div>';
        } else {
          throw new Error('Failed to save embedding');
        }
        
      } catch (error) {
        console.error('Failed to send to Rails:', error);
        resultDiv.innerHTML = '<div class="status error"> Failed to save embedding</div>';
      }
    }
    
    // API Testing Functions
    async function testApiList() {
      const btn = document.getElementById('apiListBtn');
      btn.disabled = true;
      btn.textContent = 'Loading...';
      
      try {
        const response = await fetch('/api/v1/clothing_pieces', {
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        displayApiResult('GET /clothing_pieces', response.status, data);
        
      } catch (error) {
        displayApiResult('GET /clothing_pieces', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'GET /clothing_pieces';
      }
    }
    
    async function testApiStats() {
      const btn = document.getElementById('apiStatsBtn');
      btn.disabled = true;
      btn.textContent = 'Loading...';
      
      try {
        const response = await fetch('/api/v1/embeddings/stats', {
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        displayApiResult('GET /embeddings/stats', response.status, data);
        
      } catch (error) {
        displayApiResult('GET /embeddings/stats', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'GET /embeddings/stats';
      }
    }
    
    async function testApiEmbedding() {
      const pieceId = selectedPieceId || document.getElementById('clothingPieceSelect').value;
      if (!pieceId || !currentEmbedding) {
        alert('Please select a clothing piece and generate an embedding first');
        return;
      }
      
      const btn = document.getElementById('apiEmbeddingBtn');
      btn.disabled = true;
      btn.textContent = 'Saving...';
      
      try {
        const response = await fetch(`/api/v1/clothing_pieces/${pieceId}/embedding`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            vector_data: currentEmbedding,
            model_version: 'clip-vit-base-patch32-test',
            confidence_score: 0.92
          })
        });
        
        const data = await response.json();
        displayApiResult('POST /pieces/:id/embedding', response.status, data);
        
      } catch (error) {
        displayApiResult('POST /pieces/:id/embedding', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'POST /pieces/:id/embedding';
      }
    }
    
    async function testApiSimilar() {
      const pieceId = selectedPieceId || document.getElementById('clothingPieceSelect').value;
      if (!pieceId) {
        alert('Please select a clothing piece first');
        return;
      }
      
      const btn = document.getElementById('apiSimilarBtn');
      btn.disabled = true;
      btn.textContent = 'Searching...';
      
      try {
        const response = await fetch(`/api/v1/clothing_pieces/${pieceId}/similar?limit=5`, {
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        displayApiResult('GET /pieces/:id/similar', response.status, data);
        
      } catch (error) {
        displayApiResult('GET /pieces/:id/similar', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'GET /pieces/:id/similar';
      }
    }
    
    async function testApiSearch() {
      if (!currentEmbedding) {
        alert('Please generate an embedding first');
        return;
      }
      
      const btn = document.getElementById('apiSearchBtn');
      btn.disabled = true;
      btn.textContent = 'Searching...';
      
      try {
        const response = await fetch('/api/v1/embeddings/search', {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            vector_data: currentEmbedding,
            limit: 5,
            category: 'tops' // Optional filter
          })
        });
        
        const data = await response.json();
        displayApiResult('POST /embeddings/search', response.status, data);
        
      } catch (error) {
        displayApiResult('POST /embeddings/search', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'POST /embeddings/search';
      }
    }
    
    function displayApiResult(endpoint, status, data) {
      const resultsDiv = document.getElementById('apiResults');
      const timestamp = new Date().toLocaleTimeString();
      const statusColor = status.toString().startsWith('2') ? '#28a745' : '#dc3545';
      
      const result = `
<div style="border-bottom: 1px solid #ddd; padding: 10px 0; margin: 5px 0;">
  <div style="color: ${statusColor}; font-weight: bold;">
    [${timestamp}] ${endpoint} - Status: ${status}
  </div>
  <pre style="margin: 5px 0; white-space: pre-wrap; word-wrap: break-word;">${JSON.stringify(data, null, 2)}</pre>
</div>`;
      
      resultsDiv.innerHTML = result + resultsDiv.innerHTML;
    }
    
    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', () => {
      console.log('DOM loaded, starting model initialization...');
      
      // Check if ONNX Runtime loaded
      if (typeof ort === 'undefined') {
        console.error('ONNX Runtime not loaded');
        document.getElementById('modelStatus').innerHTML = ' ONNX Runtime failed to load';
        document.getElementById('modelStatus').className = 'status error';
        return;
      }
      
      console.log('ONNX Runtime available:', ort.version);
      initializeModel();
    });      document.getElementById('topDimensions').textContent = topDims;
      
      // Enable integration controls
      document.getElementById('sendBtn').disabled = false;
      document.getElementById('apiEmbeddingBtn').disabled = false;
      document.getElementById('apiSimilarBtn').disabled = false;
      document.getElementById('apiSearchBtn').disabled = false;
      document.getElementById('resultsSection').style.display = 'block';
    }
    
    function copyEmbedding() {
      if (!currentEmbedding) return;
      
      navigator.clipboard.writeText(currentEmbedding.map(v => v.toFixed(6)).join(', ')).then(() => {
        const btn = document.getElementById('copyBtn');
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = originalText, 2000);
      });
    }
    
    function clearImage() {
      imagePreview.style.display = 'none';
      document.getElementById('resultsSection').style.display = 'none';
      imageInput.value = '';
      currentEmbedding = null;
      selectedPieceId = null;
    }
    
    // Web form submission (original method)
    async function sendToRails() {
      const pieceId = document.getElementById('clothingPieceSelect').value;
      if (!pieceId || !currentEmbedding) return;
      
      const resultDiv = document.getElementById('railsResult');
      resultDiv.innerHTML = '<div class="status loading">Sending to Rails...</div>';
      
      try {
        const formData = new FormData();
        formData.append('vector_data', currentEmbedding.map(v => v.toFixed(6)).join(','));
        formData.append('model_version', 'clip-vit-base-patch32');
        formData.append('confidence_score', '0.90');
        
        const response = await fetch(`/closet/${pieceId}/upload_embedding`, {
          method: 'POST',
          body: formData,
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
          }
        });
        
        if (response.ok) {
          resultDiv.innerHTML = '<div class="status success"> Web form upload successful!</div>';
        } else {
          throw new Error('Failed to save embedding');
        }
        
      } catch (error) {
        console.error('Failed to send to Rails:', error);
        resultDiv.innerHTML = '<div class="status error"> Failed to save embedding</div>';
      }
    }
    
    // API Testing Functions
    async function testApiList() {
      const btn = document.getElementById('apiListBtn');
      btn.disabled = true;
      btn.textContent = 'Loading...';
      
      try {
        const response = await fetch('/api/v1/clothing_pieces', {
          headers: {
            'Authorization': 'Bearer <%= current_user.email %>',
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        displayApiResult('GET /clothing_pieces', response.status, data);
        
      } catch (error) {
        displayApiResult('GET /clothing_pieces', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'GET /clothing_pieces';
      }
    }
    
    async function testApiStats() {
      const btn = document.getElementById('apiStatsBtn');
      btn.disabled = true;
      btn.textContent = 'Loading...';
      
      try {
        const response = await fetch('/api/v1/embeddings/stats', {
          headers: {
            'Authorization': 'Bearer <%= current_user.email %>',
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        displayApiResult('GET /embeddings/stats', response.status, data);
        
      } catch (error) {
        displayApiResult('GET /embeddings/stats', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'GET /embeddings/stats';
      }
    }
    
    async function testApiEmbedding() {
      const pieceId = selectedPieceId || document.getElementById('clothingPieceSelect').value;
      if (!pieceId || !currentEmbedding) {
        alert('Please select a clothing piece and generate an embedding first');
        return;
      }
      
      const btn = document.getElementById('apiEmbeddingBtn');
      btn.disabled = true;
      btn.textContent = 'Saving...';
      
      try {
        const response = await fetch(`/api/v1/clothing_pieces/${pieceId}/embedding`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer <%= current_user.email %>',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            vector_data: currentEmbedding,
            model_version: 'clip-vit-base-patch32-test',
            confidence_score: 0.92
          })
        });
        
        const data = await response.json();
        displayApiResult('POST /pieces/:id/embedding', response.status, data);
        
      } catch (error) {
        displayApiResult('POST /pieces/:id/embedding', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'POST /pieces/:id/embedding';
      }
    }
    
    async function testApiSimilar() {
      const pieceId = selectedPieceId || document.getElementById('clothingPieceSelect').value;
      if (!pieceId) {
        alert('Please select a clothing piece first');
        return;
      }
      
      const btn = document.getElementById('apiSimilarBtn');
      btn.disabled = true;
      btn.textContent = 'Searching...';
      
      try {
        const response = await fetch(`/api/v1/clothing_pieces/${pieceId}/similar?limit=5`, {
          headers: {
            'Authorization': 'Bearer <%= current_user.email %>',
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        displayApiResult('GET /pieces/:id/similar', response.status, data);
        
      } catch (error) {
        displayApiResult('GET /pieces/:id/similar', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'GET /pieces/:id/similar';
      }
    }
    
    async function testApiSearch() {
      if (!currentEmbedding) {
        alert('Please generate an embedding first');
        return;
      }
      
      const btn = document.getElementById('apiSearchBtn');
      btn.disabled = true;
      btn.textContent = 'Searching...';
      
      try {
        const response = await fetch('/api/v1/embeddings/search', {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer <%= current_user.email %>',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            vector_data: currentEmbedding,
            limit: 5,
            category: 'tops' // Optional filter
          })
        });
        
        const data = await response.json();
        displayApiResult('POST /embeddings/search', response.status, data);
        
      } catch (error) {
        displayApiResult('POST /embeddings/search', 'ERROR', { error: error.message });
      } finally {
        btn.disabled = false;
        btn.textContent = 'POST /embeddings/search';
      }
    }
    
    function displayApiResult(endpoint, status, data) {
      const resultsDiv = document.getElementById('apiResults');
      const timestamp = new Date().toLocaleTimeString();
      const statusColor = status.toString().startsWith('2') ? '#28a745' : '#dc3545';
      
      const result = `
<div style="border-bottom: 1px solid #ddd; padding: 10px 0; margin: 5px 0;">
  <div style="color: ${statusColor}; font-weight: bold;">
    [${timestamp}] ${endpoint} - Status: ${status}
  </div>
  <pre style="margin: 5px 0; white-space: pre-wrap; word-wrap: break-word;">${JSON.stringify(data, null, 2)}</pre>
</div>`;
      
      resultsDiv.innerHTML = result + resultsDiv.innerHTML;
    }
    
    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', initializeModel);
  </script>
</body>
</html>