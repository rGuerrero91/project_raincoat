<!DOCTYPE html>
<html>
<head>
  <title>Raincoat POC - My Closet</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: Arial, sans-serif; max-width: 1200px; margin: 0 auto; padding: 20px; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .upload-form { background: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 30px; }
    .form-group { margin-bottom: 15px; }
    label { display: block; margin-bottom: 5px; font-weight: bold; }
    input, select, textarea { padding: 8px; border: 1px solid #ddd; border-radius: 4px; }
    input[type="text"], input[type="file"], select, textarea { width: 100%; }
    button { background: #007cba; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; }
    button:hover { background: #005a87; }
    .items-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
    .item-card { border: 1px solid #ddd; border-radius: 8px; padding: 15px; background: white; }
    .item-image { width: 100%; height: 200px; object-fit: cover; border-radius: 4px; margin-bottom: 10px; }
    .item-info h3 { margin: 0 0 10px 0; }
    .item-meta { font-size: 14px; color: #666; margin: 5px 0; }
    .embedding-status { padding: 5px 10px; border-radius: 20px; font-size: 12px; font-weight: bold; }
    .has-embedding { background: #d4edda; color: #155724; }
    .no-embedding { background: #f8d7da; color: #721c24; }
    .actions { margin-top: 10px; }
    .actions a { display: inline-block; padding: 5px 10px; background: #6c757d; color: white; text-decoration: none; border-radius: 4px; margin-right: 5px; font-size: 12px; }
    .actions a:hover { background: #5a6268; }
    .notice { background: #d4edda; color: #155724; padding: 10px; border-radius: 4px; margin-bottom: 20px; }
    .alert { background: #f8d7da; color: #721c24; padding: 10px; border-radius: 4px; margin-bottom: 20px; }
  </style>
</head>
<body>
  <div class="header">
    <h1>Raincoat POC - My Closet</h1>
    <div>
      Welcome, <%= current_user.name %>! 
      <%= link_to "Logout", logout_path, method: :delete, style: "margin-left: 10px;" %>
    </div>
  </div>
  
  <% if notice %>
    <div class="notice"><%= notice %></div>
  <% end %>
  
  <% if alert %>
    <div class="alert"><%= alert %></div>
  <% end %>
  
  <!-- Upload Form -->
  <div class="upload-form">
    <h2>Upload New Clothing Item</h2>
    <%= form_with model: @clothing_item, local: true, multipart: true do |f| %>
      <% if @clothing_item.errors.any? %>
        <div class="alert">
          <ul>
            <% @clothing_item.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <div class="form-group">
        <%= f.label :name %>
        <%= f.text_field :name, placeholder: "e.g., Blue Cotton T-Shirt", required: true %>
      </div>
      
      <div class="form-group">
        <%= f.label :category %>
        <%= f.select :category, 
            options_for_select([
              ['Tops', 'tops'],
              ['Bottoms', 'bottoms'], 
              ['Outerwear', 'outerwear'],
              ['Shoes', 'shoes'],
              ['Accessories', 'accessories']
            ], @clothing_item.category), 
            { prompt: 'Select Category' }, 
            { required: true } %>
      </div>
      
      <div class="form-group">
        <%= f.label :description %>
        <%= f.text_area :description, rows: 3, placeholder: "Describe the item..." %>
      </div>
      
      <div class="form-group">
        <%= f.label :brand %>
        <%= f.text_field :brand, placeholder: "e.g., Nike, H&M, etc." %>
      </div>
      
      <div class="form-group">
        <%= f.label :images, "Upload Images" %>
        <%= f.file_field :images, multiple: true, accept: "image/*" %>
      </div>
      
      <%= f.submit "Upload Item", class: "button" %>
    <% end %>
  </div>
  
  <!-- Items Grid -->
  <h2>My Items (<%= @clothing_items.count %>)</h2>
  
  <% if @clothing_items.any? %>
    <div class="items-grid">
      <% @clothing_items.each do |item| %>
        <div class="item-card">
          <% if item.images.attached? %>
            <%= image_tag item.images.first, class: "item-image", alt: item.name %>
          <% else %>
            <div class="item-image" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #999;">
              No Image
            </div>
          <% end %>
          
          <div class="item-info">
            <h3><%= item.name %></h3>
            <div class="item-meta">Category: <%= item.category&.humanize %></div>
            <div class="item-meta">Brand: <%= item.brand || 'Not specified' %></div>
            <div class="item-meta">
              <% if item.clothing_embedding %>
                <span class="embedding-status has-embedding">Has Embedding</span>
              <% else %>
                <span class="embedding-status no-embedding">No Embedding</span>
              <% end %>
            </div>
            
            <div class="actions">
              <%= link_to "View", item %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No clothing items yet. Upload your first item above!</p>
  <% end %>
</body>
</html>