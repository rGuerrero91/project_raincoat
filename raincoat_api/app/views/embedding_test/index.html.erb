<!DOCTYPE html>
<html>
<head>
  <title>TinyCLIP Embedding Test - Raincoat POC</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: Arial, sans-serif; max-width: 1000px; margin: 0 auto; padding: 20px; }
    .test-section { background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0; }
    .upload-area { border: 2px dashed #ddd; padding: 40px; text-align: center; border-radius: 8px; margin: 20px 0; cursor: pointer; }
    .upload-area:hover { border-color: #007cba; background: #f0f8ff; }
    .upload-area.dragover { border-color: #007cba; background: #e6f3ff; }
    .preview-image { max-width: 300px; max-height: 300px; border-radius: 8px; margin: 10px; border: 1px solid #ddd; }
    .results-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
    .result-section { background: white; padding: 15px; border-radius: 8px; border: 1px solid #ddd; }
    .embedding-output { background: #f8f9fa; padding: 10px; border-radius: 4px; font-family: monospace; font-size: 12px; max-height: 200px; overflow-y: auto; word-break: break-all; }
    .status { padding: 10px; border-radius: 4px; margin: 10px 0; }
    .status.loading { background: #fff3cd; color: #856404; }
    .status.success { background: #d4edda; color: #155724; }
    .status.error { background: #f8d7da; color: #721c24; }
    button { background: #007cba; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; margin: 5px; }
    button:hover { background: #005a87; }
    button:disabled { background: #6c757d; cursor: not-allowed; }
    .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 10px 0; }
    .metric { background: white; padding: 10px; border-radius: 4px; text-align: center; border: 1px solid #ddd; }
    .metric-value { font-size: 24px; font-weight: bold; color: #007cba; }
    .metric-label { font-size: 12px; color: #666; }
    .back-link { margin-bottom: 20px; }
    .back-link a { color: #007cba; text-decoration: none; }
  </style>
</head>
<body>
  <div class="back-link">
    <a href="<%= clothing_pieces_path %>">&larr; Back to Wardrobe</a>
  </div>
  
  <h1>TinyCLIP Embedding Test</h1>
  <p>Test client-side image embedding generation using TinyCLIP model via ONNX.js</p>
  
  <!-- Model Loading Section -->
  <div class="test-section">
    <h2>Model Status</h2>
    <div id="modelStatus" class="status loading">Loading TinyCLIP model...</div>
    <div class="metrics">
      <div class="metric">
        <div class="metric-value" id="modelSize">-</div>
        <div class="metric-label">Model Size (MB)</div>
      </div>
      <div class="metric">
        <div class="metric-value" id="loadTime">-</div>
        <div class="metric-label">Load Time (ms)</div>
      </div>
      <div class="metric">
        <div class="metric-value" id="inferenceTime">-</div>
        <div class="metric-label">Last Inference (ms)</div>
      </div>
    </div>
  </div>
  
  <!-- Image Upload Section -->
  <div class="test-section">
    <h2>Image Upload & Processing</h2>
    
    <div class="upload-area" id="uploadArea">
      <p><strong>Drop an image here or click to select</strong></p>
      <p>Supported: JPG, PNG, WebP</p>
      <input type="file" id="imageInput" accept="image/*" style="display: none;">
    </div>
    
    <div id="imagePreview" style="display: none;">
      <h3>Selected Image:</h3>
      <img id="previewImg" class="preview-image" alt="Preview">
      <div>
        <button id="processBtn" onclick="processImage()">Generate Embedding</button>
        <button onclick="clearImage()">Clear</button>
      </div>
    </div>
  </div>
  
  <!-- Results Section -->
  <div class="test-section" id="resultsSection" style="display: none;">
    <h2>Embedding Results</h2>
    
    <div class="results-grid">
      <div class="result-section">
        <h3>Embedding Vector (512 dimensions)</h3>
        <div id="embeddingVector" class="embedding-output">
          Processing...
        </div>
        <button onclick="copyEmbedding()" id="copyBtn" style="margin-top: 10px;">Copy to Clipboard</button>
      </div>
      
      <div class="result-section">
        <h3>Analysis</h3>
        <div id="embeddingAnalysis">
          <div class="metric">
            <div class="metric-value" id="vectorMagnitude">-</div>
            <div class="metric-label">Vector Magnitude</div>
          </div>
          <div style="margin-top: 15px;">
            <strong>Top Dimensions:</strong>
            <div id="topDimensions" style="font-family: monospace; font-size: 12px; margin-top: 5px;"></div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Integration Test -->
    <div style="margin-top: 20px; padding: 15px; background: #e6f3ff; border-radius: 4px;">
      <h4>Test Integration with Rails Backend</h4>
      <p>Select a clothing piece to update with this embedding:</p>
      <select id="clothingPieceSelect">
        <option value="">Select a clothing piece...</option>
        <% current_user.clothing_pieces.each do |piece| %>
          <option value="<%= piece.id %>"><%= piece.name %> (<%= piece.category %>)</option>
        <% end %>
      </select>
      <button onclick="sendToRails()" id="sendBtn" disabled>Send Embedding to Rails</button>
      <div id="railsResult" style="margin-top: 10px;"></div>
    </div>
  </div>

  <!-- ONNX.js and TinyCLIP Integration -->
  <script src="https://cdn.jsdelivr.net/npm/onnxruntime-web@1.16.3/dist/ort.min.js"></script>
  
  <script>
    let session = null;
    let currentEmbedding = null;
    let modelLoadStart = null;
    
    // Initialize ONNX Runtime and load TinyCLIP model
    async function initializeModel() {
      try {
        modelLoadStart = performance.now();
        
        // Note: For this POC, we'll simulate TinyCLIP model loading
        // In production, you'd load the actual ONNX model file
        console.log('Initializing ONNX Runtime...');
        
        // Simulate model loading delay
        await new Promise(resolve => setTimeout(resolve, 2000));
        
        const loadTime = Math.round(performance.now() - modelLoadStart);
        
        // Update UI
        document.getElementById('modelStatus').innerHTML = '✅ TinyCLIP model loaded successfully';
        document.getElementById('modelStatus').className = 'status success';
        document.getElementById('loadTime').textContent = loadTime;
        document.getElementById('modelSize').textContent = '~40'; // TinyCLIP is ~40MB
        
        console.log('Model loaded successfully');
        
      } catch (error) {
        console.error('Failed to load model:', error);
        document.getElementById('modelStatus').innerHTML = '❌ Failed to load model: ' + error.message;
        document.getElementById('modelStatus').className = 'status error';
      }
    }
    
    // Image upload handling
    const uploadArea = document.getElementById('uploadArea');
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    
    uploadArea.addEventListener('click', () => imageInput.click());
    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('dragover');
    });
    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('dragover');
    });
    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('dragover');
      const files = e.dataTransfer.files;
      if (files.length > 0) handleImageUpload(files[0]);
    });
    
    imageInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) handleImageUpload(e.target.files[0]);
    });
    
    function handleImageUpload(file) {
      if (!file.type.startsWith('image/')) {
        alert('Please select an image file');
        return;
      }
      
      const reader = new FileReader();
      reader.onload = (e) => {
        previewImg.src = e.target.result;
        imagePreview.style.display = 'block';
        document.getElementById('resultsSection').style.display = 'none';
      };
      reader.readAsDataURL(file);
    }
    
    // Process image and generate embedding
    async function processImage() {
      const processBtn = document.getElementById('processBtn');
      processBtn.disabled = true;
      processBtn.textContent = 'Processing...';
      
      try {
        const inferenceStart = performance.now();
        
        // For POC: Generate a realistic fake embedding
        // In production, this would run the actual TinyCLIP model
        const embedding = generateMockEmbedding();
        
        const inferenceTime = Math.round(performance.now() - inferenceStart);
        document.getElementById('inferenceTime').textContent = inferenceTime;
        
        currentEmbedding = embedding;
        displayResults(embedding);
        
      } catch (error) {
        console.error('Processing failed:', error);
        alert('Failed to process image: ' + error.message);
      } finally {
        processBtn.disabled = false;
        processBtn.textContent = 'Generate Embedding';
      }
    }
    
    // Generate realistic mock embedding (replace with actual TinyCLIP later)
    function generateMockEmbedding() {
      const embedding = [];
      for (let i = 0; i < 512; i++) {
        // Generate values that follow a roughly normal distribution
        const value = (Math.random() - 0.5) * 2 * Math.sqrt(1/512);
        embedding.push(parseFloat(value.toFixed(6)));
      }
      return embedding;
    }
    
    function displayResults(embedding) {
      // Show embedding vector
      document.getElementById('embeddingVector').textContent = embedding.join(', ');
      
      // Calculate vector magnitude
      const magnitude = Math.sqrt(embedding.reduce((sum, val) => sum + val * val, 0));
      document.getElementById('vectorMagnitude').textContent = magnitude.toFixed(4);
      
      // Show top dimensions
      const indexed = embedding.map((val, idx) => ({ value: val, index: idx }));
      indexed.sort((a, b) => Math.abs(b.value) - Math.abs(a.value));
      const topDims = indexed.slice(0, 5).map(item => 
        `[${item.index}]: ${item.value.toFixed(4)}`
      ).join('\\n');
      document.getElementById('topDimensions').textContent = topDims;
      
      // Enable integration controls
      document.getElementById('sendBtn').disabled = false;
      document.getElementById('resultsSection').style.display = 'block';
    }
    
    function copyEmbedding() {
      if (!currentEmbedding) return;
      
      navigator.clipboard.writeText(currentEmbedding.join(', ')).then(() => {
        const btn = document.getElementById('copyBtn');
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = originalText, 2000);
      });
    }
    
    function clearImage() {
      imagePreview.style.display = 'none';
      document.getElementById('resultsSection').style.display = 'none';
      imageInput.value = '';
      currentEmbedding = null;
    }
    
    // Send embedding to Rails backend
    async function sendToRails() {
      const pieceId = document.getElementById('clothingPieceSelect').value;
      if (!pieceId || !currentEmbedding) return;
      
      const resultDiv = document.getElementById('railsResult');
      resultDiv.innerHTML = '<div class="status loading">Sending to Rails...</div>';
      
      try {
        const formData = new FormData();
        formData.append('vector_data', currentEmbedding.join(','));
        formData.append('model_version', 'tinyclip-1.0-test');
        formData.append('confidence_score', '0.85');
        
        const response = await fetch(`/wardrobe/${pieceId}/upload_embedding`, {
          method: 'POST',
          body: formData,
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
          }
        });
        
        if (response.ok) {
          resultDiv.innerHTML = '<div class="status success">✅ Embedding saved successfully!</div>';
        } else {
          throw new Error('Failed to save embedding');
        }
        
      } catch (error) {
        console.error('Failed to send to Rails:', error);
        resultDiv.innerHTML = '<div class="status error">❌ Failed to save embedding</div>';
      }
    }
    
    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', initializeModel);
  </script>
</body>
</html>

<%= csrf_meta_tags %>