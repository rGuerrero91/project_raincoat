<!-- app/views/embedding_test/index.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <title>API Embedding Test - Raincoat POC</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <style>
    body { font-family: Arial, sans-serif; max-width: 1000px; margin: 0 auto; padding: 20px; }
    .test-section { background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0; }
    .form-group { margin-bottom: 15px; }
    label { display: block; margin-bottom: 5px; font-weight: bold; }
    input, select, textarea { padding: 8px; border: 1px solid #ddd; border-radius: 4px; width: 100%; }
    button { background: #007cba; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; margin: 5px; }
    button:hover { background: #005a87; }
    button:disabled { background: #6c757d; cursor: not-allowed; }
    .results { background: white; padding: 15px; border-radius: 8px; border: 1px solid #ddd; margin-top: 15px; }
    .api-response { background: #f8f9fa; padding: 10px; border-radius: 4px; font-family: monospace; font-size: 12px; max-height: 400px; overflow-y: auto; word-break: break-all; white-space: pre-wrap; }
    .status { padding: 10px; border-radius: 4px; margin: 10px 0; }
    .status.loading { background: #fff3cd; color: #856404; }
    .status.success { background: #d4edda; color: #155724; }
    .status.error { background: #f8d7da; color: #721c24; }
    .back-link { margin-bottom: 20px; }
    .back-link a { color: #007cba; text-decoration: none; }
    .api-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  </style>
</head>
<body>
  <div class="back-link">
    <a href="<%= clothing_pieces_path %>">&larr; Back to Closet</a>
  </div>
  
  <h1>API Embedding Test</h1>
  <p>Test the embedding API endpoints with mock data and real clothing pieces.</p>
  
  <!-- API Statistics -->
  <div class="test-section">
    <h2>API Status & Statistics</h2>
    <button onclick="testApiStats()">GET /api/v1/embeddings/stats</button>
    <button onclick="testApiList()">GET /api/v1/clothing_pieces</button>
    <div id="statsResults" class="results" style="display: none;">
      <div id="statsResponse" class="api-response"></div>
    </div>
  </div>
  
  <!-- Mock Embedding Upload -->
  <div class="test-section">
    <h2>Upload Mock Embedding</h2>
    <p>Test embedding storage with generated mock vectors</p>
    
    <div class="form-group">
      <label for="mockPieceSelect">Select Clothing Piece:</label>
      <select id="mockPieceSelect">
        <option value="">Choose a clothing piece...</option>
        <% current_user.clothing_pieces.each do |piece| %>
          <option value="<%= piece.id %>"><%= piece.name %> (<%= piece.category %>)</option>
        <% end %>
      </select>
    </div>
    
    <div class="form-group">
      <label for="mockModelVersion">Model Version:</label>
      <input type="text" id="mockModelVersion" value="mock-test-1.0" placeholder="e.g., clip-vit-base-patch32">
    </div>
    
    <div class="form-group">
      <label for="mockConfidence">Confidence Score (0-1):</label>
      <input type="number" id="mockConfidence" value="0.85" step="0.01" min="0" max="1">
    </div>
    
    <button onclick="generateAndUploadMockEmbedding()">Generate & Upload Mock Embedding</button>
    
    <div id="mockResults" class="results" style="display: none;">
      <h4>Mock Embedding Response:</h4>
      <div id="mockResponse" class="api-response"></div>
    </div>
  </div>
  
  <!-- Manual Embedding Upload -->
  <div class="test-section">
    <h2>Upload Custom Embedding</h2>
    <p>Test with your own 512-dimensional vector</p>
    
    <div class="form-group">
      <label for="customPieceSelect">Select Clothing Piece:</label>
      <select id="customPieceSelect">
        <option value="">Choose a clothing piece...</option>
        <% current_user.clothing_pieces.each do |piece| %>
          <option value="<%= piece.id %>"><%= piece.name %> (<%= piece.category %>)</option>
        <% end %>
      </select>
    </div>
    
    <div class="form-group">
      <label for="customVector">Embedding Vector (512 comma-separated numbers):</label>
      <textarea id="customVector" rows="4" placeholder="0.123, -0.456, 0.789, ... (512 values)"></textarea>
      <small>
        <a href="javascript:void(0)" onclick="fillSampleVector()">Click here to fill with sample vector</a>
      </small>
    </div>
    
    <div class="form-group">
      <label for="customModelVersion">Model Version:</label>
      <input type="text" id="customModelVersion" value="custom-test-1.0">
    </div>
    
    <button onclick="uploadCustomEmbedding()">Upload Custom Embedding</button>
    
    <div id="customResults" class="results" style="display: none;">
      <h4>Custom Embedding Response:</h4>
      <div id="customResponse" class="api-response"></div>
    </div>
  </div>
  
  <!-- Similarity Search Tests -->
  <div class="test-section">
    <h2>Similarity Search</h2>
    <div class="api-grid">
      <div>
        <h4>Search by Piece</h4>
        <div class="form-group">
          <label for="similarPieceSelect">Select Piece with Embedding:</label>
          <select id="similarPieceSelect">
            <option value="">Choose a piece...</option>
            <% current_user.clothing_pieces.joins(:clothing_embedding).each do |piece| %>
              <option value="<%= piece.id %>"><%= piece.name %> (has embedding)</option>
            <% end %>
          </select>
        </div>
        <button onclick="testSimilarByPiece()">Find Similar Items</button>
        <div id="similarResults" class="results" style="display: none;">
          <div id="similarResponse" class="api-response"></div>
        </div>
      </div>
      
      <div>
        <h4>Search by Vector</h4>
        <div class="form-group">
          <label for="searchVector">Search Vector:</label>
          <textarea id="searchVector" rows="3" placeholder="Paste 512-dimensional vector..."></textarea>
        </div>
        <div class="form-group">
          <label for="categoryFilter">Category Filter (optional):</label>
          <select id="categoryFilter">
            <option value="">All categories</option>
            <option value="tops">Tops</option>
            <option value="bottoms">Bottoms</option>
            <option value="outerwear">Outerwear</option>
            <option value="shoes">Shoes</option>
            <option value="accessories">Accessories</option>
          </select>
        </div>
        <button onclick="testSearchByVector()">Search by Vector</button>
        <div id="vectorSearchResults" class="results" style="display: none;">
          <div id="vectorSearchResponse" class="api-response"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const USER_EMAIL = '<%= j(current_user.email) %>';
    
    // Test API Statistics
    async function testApiStats() {
      try {
        const response = await fetch('/api/v1/embeddings/stats', {
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        document.getElementById('statsResults').style.display = 'block';
        document.getElementById('statsResponse').textContent = JSON.stringify(data, null, 2);
        
      } catch (error) {
        document.getElementById('statsResults').style.display = 'block';
        document.getElementById('statsResponse').textContent = 'Error: ' + error.message;
      }
    }
    
    // Test API Clothing Pieces List
    async function testApiList() {
      try {
        const response = await fetch('/api/v1/clothing_pieces', {
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        document.getElementById('statsResults').style.display = 'block';
        document.getElementById('statsResponse').textContent = JSON.stringify(data, null, 2);
        
      } catch (error) {
        document.getElementById('statsResults').style.display = 'block';
        document.getElementById('statsResponse').textContent = 'Error: ' + error.message;
      }
    }
    
    // Generate mock embedding vector
    function generateMockVector() {
      const vector = [];
      for (let i = 0; i < 512; i++) {
        vector.push((Math.random() - 0.5) * 2);
      }
      return vector;
    }
    
    // Generate and upload mock embedding
    async function generateAndUploadMockEmbedding() {
      const pieceId = document.getElementById('mockPieceSelect').value;
      if (!pieceId) {
        alert('Please select a clothing piece first');
        return;
      }
      
      const mockVector = generateMockVector();
      const modelVersion = document.getElementById('mockModelVersion').value;
      const confidence = parseFloat(document.getElementById('mockConfidence').value);
      
      try {
        const response = await fetch(`/api/v1/clothing_pieces/${pieceId}/embedding`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            vector_data: mockVector,
            model_version: modelVersion,
            confidence_score: confidence
          })
        });
        
        const data = await response.json();
        document.getElementById('mockResults').style.display = 'block';
        document.getElementById('mockResponse').textContent = JSON.stringify(data, null, 2);
        
        // Update similarity search dropdowns
        location.reload(); // Simple way to refresh the "has embedding" dropdown
        
      } catch (error) {
        document.getElementById('mockResults').style.display = 'block';
        document.getElementById('mockResponse').textContent = 'Error: ' + error.message;
      }
    }
    
    // Fill sample vector
    function fillSampleVector() {
      const sampleVector = generateMockVector().map(v => v.toFixed(6)).join(', ');
      document.getElementById('customVector').value = sampleVector;
    }
    
    // Upload custom embedding
    async function uploadCustomEmbedding() {
      const pieceId = document.getElementById('customPieceSelect').value;
      const vectorText = document.getElementById('customVector').value.trim();
      const modelVersion = document.getElementById('customModelVersion').value;
      
      if (!pieceId) {
        alert('Please select a clothing piece first');
        return;
      }
      
      if (!vectorText) {
        alert('Please provide a vector');
        return;
      }
      
      // Parse vector
      const vector = vectorText.split(',').map(v => parseFloat(v.trim()));
      if (vector.length !== 512) {
        alert(`Vector must have 512 dimensions, got ${vector.length}`);
        return;
      }
      
      try {
        const response = await fetch(`/api/v1/clothing_pieces/${pieceId}/embedding`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            vector_data: vector,
            model_version: modelVersion,
            confidence_score: 0.95
          })
        });
        
        const data = await response.json();
        document.getElementById('customResults').style.display = 'block';
        document.getElementById('customResponse').textContent = JSON.stringify(data, null, 2);
        
      } catch (error) {
        document.getElementById('customResults').style.display = 'block';
        document.getElementById('customResponse').textContent = 'Error: ' + error.message;
      }
    }
    
    // Test similarity by piece
    async function testSimilarByPiece() {
      const pieceId = document.getElementById('similarPieceSelect').value;
      if (!pieceId) {
        alert('Please select a piece with an embedding');
        return;
      }
      
      try {
        const response = await fetch(`/api/v1/clothing_pieces/${pieceId}/similar?limit=5`, {
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          }
        });
        
        const data = await response.json();
        document.getElementById('similarResults').style.display = 'block';
        document.getElementById('similarResponse').textContent = JSON.stringify(data, null, 2);
        
      } catch (error) {
        document.getElementById('similarResults').style.display = 'block';
        document.getElementById('similarResponse').textContent = 'Error: ' + error.message;
      }
    }
    
    // Test search by vector
    async function testSearchByVector() {
      const vectorText = document.getElementById('searchVector').value.trim();
      const category = document.getElementById('categoryFilter').value;
      
      if (!vectorText) {
        alert('Please provide a search vector');
        return;
      }
      
      const vector = vectorText.split(',').map(v => parseFloat(v.trim()));
      if (vector.length !== 512) {
        alert(`Vector must have 512 dimensions, got ${vector.length}`);
        return;
      }
      
      const payload = {
        vector_data: vector,
        limit: 5
      };
      
      if (category) {
        payload.category = category;
      }
      
      try {
        const response = await fetch('/api/v1/embeddings/search', {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + USER_EMAIL,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });
        
        const data = await response.json();
        document.getElementById('vectorSearchResults').style.display = 'block';
        document.getElementById('vectorSearchResponse').textContent = JSON.stringify(data, null, 2);
        
      } catch (error) {
        document.getElementById('vectorSearchResults').style.display = 'block';
        document.getElementById('vectorSearchResponse').textContent = 'Error: ' + error.message;
      }
    }
    
  <!-- Add ONNX.js model testing section -->
  <div class="test-section">
    <h2>ONNX.js Model Testing</h2>
    <p>Test loading CLIP model for real embedding generation</p>
    
    <div class="form-group">
      <label for="modelSelect">Select Model Source:</label>
      <select id="modelSelect">
