<!DOCTYPE html>
<html>
<head>
  <title>VanillaCLIP Model Test</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <style>
    body { font-family: Arial, sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; }
    .upload-area { border: 2px dashed #ccc; padding: 40px; text-align: center; border-radius: 8px; cursor: pointer; }
    .upload-area:hover { border-color: #007cba; background: #f9f9f9; }
    .preview { text-align: center; margin: 20px 0; }
    .preview img { max-width: 200px; max-height: 200px; border-radius: 8px; }
    .results { background: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0; font-family: monospace; font-size: 12px; }
    .status { padding: 10px; border-radius: 4px; margin: 10px 0; text-align: center; }
    .loading { background: #fff3cd; color: #856404; }
    .success { background: #d4edda; color: #155724; }
    .error { background: #f8d7da; color: #721c24; }
    button { background: #007cba; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; }
    button:disabled { background: #ccc; }
  </style>
</head>
<body>
  <h1>VanillaCLIP Model Test</h1>
  
  <div class="upload-area" onclick="document.getElementById('imageInput').click()">
    <p>Click to upload an image</p>
    <input type="file" id="imageInput" accept="image/*" style="display: none;">
  </div>
  
  <div id="preview" class="preview" style="display: none;">
    <img id="previewImage" alt="Preview">
    <br><br>
    <button onclick="processImage()">Process Image</button>
    <button onclick="clearImage()">Clear</button>
  </div>
  
  <div id="status" class="status" style="display: none;"></div>
  <div id="results" class="results" style="display: none;"></div>

  <script src="/js/onnx/ort.min.js"></script>
  
  <script>
    let modelSession = null;
    const MODEL_URL = window.location.origin + '/models/clip-vit-base-patch32/vision_model_quantized.onnx';
    
    // Load model on page load
    window.addEventListener('load', async () => {
      showStatus('Loading CLIP model...', 'loading');
      
      try {
        ort.env.wasm.wasmPaths = '/js/onnx/';
        modelSession = await ort.InferenceSession.create(MODEL_URL);
        showStatus('Model loaded successfully', 'success');
      } catch (error) {
        showStatus('Failed to load model: ' + error.message, 'error');
      }
    });
    
    // Handle image upload
    document.getElementById('imageInput').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (e) => {
          document.getElementById('previewImage').src = e.target.result;
          document.getElementById('preview').style.display = 'block';
          document.getElementById('results').style.display = 'none';
        };
        reader.readAsDataURL(file);
      }
    });
    
    async function processImage() {
      if (!modelSession) {
        alert('Model not loaded yet');
        return;
      }
      
      showStatus('Processing image...', 'loading');
      
      try {
        const img = document.getElementById('previewImage');
        
        // Preprocess image
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        canvas.width = 224;
        canvas.height = 224;
        ctx.drawImage(img, 0, 0, 224, 224);
        
        const imageData = ctx.getImageData(0, 0, 224, 224);
        const tensorData = new Float32Array(3 * 224 * 224);
        
        // Convert to tensor (simple normalization)
        for (let i = 0; i < 224 * 224; i++) {
          const pixelIndex = i * 4;
          tensorData[i] = (imageData.data[pixelIndex] / 255.0 - 0.5) * 2; // R
          tensorData[224 * 224 + i] = (imageData.data[pixelIndex + 1] / 255.0 - 0.5) * 2; // G
          tensorData[2 * 224 * 224 + i] = (imageData.data[pixelIndex + 2] / 255.0 - 0.5) * 2; // B
        }
        
        const tensor = new ort.Tensor('float32', tensorData, [1, 3, 224, 224]);
        
        // Run inference
        const feeds = {};
        feeds[modelSession.inputNames[0]] = tensor;
        const outputs = await modelSession.run(feeds);
        
        // Get embedding
        const embedding = Array.from(outputs[modelSession.outputNames[0]].data);
        
        // Ensure 512 dimensions
        const finalEmbedding = embedding.length >= 512 ? 
          embedding.slice(0, 512) : 
          [...embedding, ...new Array(512 - embedding.length).fill(0)];
        
        showStatus('Processing complete', 'success');
        showResults(finalEmbedding);
        
      } catch (error) {
        showStatus('Processing failed: ' + error.message, 'error');
      }
    }
    
    function showStatus(message, type) {
      const status = document.getElementById('status');
      status.textContent = message;
      status.className = 'status ' + type;
      status.style.display = 'block';
    }
    
    function showResults(embedding) {
      const results = document.getElementById('results');
      results.innerHTML = 
        'Embedding generated successfully\n' +
        'Dimensions: ' + embedding.length + '\n' +
        'Sample values: ' + embedding.slice(0, 10).map(v => v.toFixed(4)).join(', ') + '\n\n' +
        'Full embedding:\n' + embedding.map(v => v.toFixed(6)).join(', ');
      results.style.display = 'block';
    }
    
    function clearImage() {
      document.getElementById('preview').style.display = 'none';
      document.getElementById('results').style.display = 'none';
      document.getElementById('imageInput').value = '';
    }
  </script>
</body>
</html>