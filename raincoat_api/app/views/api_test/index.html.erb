    <div id="modelResults" class="results" style="display: none;">
      <h4>Model Loading Results:</h4>
      <div id="modelResponse" class="api-response"></div>
    </div>
    
    <!-- Image upload for real processing -->
    <div id="realProcessingSection" style="display: none; margin-top: 20px; padding: 15px; border: 2px dashed #ddd; border-radius: 8px;">
      <h4>Real Image Processing</h4>
      <input type="file" id="imageInput" accept="image/*">
      <button onclick="processImageWithModel()" id="processImageBtn" disabled>Process Image</button>
      <div id="imageProcessResults" style="margin-top: 10px;"></div>
    </div>
  </div>
  </script>
